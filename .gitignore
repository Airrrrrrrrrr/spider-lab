# Python 虚拟环境与缓存（严禁提交，确保与系统全局 Python 3.6.8 隔离）
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node.js 依赖与日志
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量、临时输出与本地会话敏感信息（禁止硬编码提交 Cookie/密钥）
.env
.env.*
!.env.example
logs/
*.log
tmp/
output/
*.cookies.json

# 编辑器与操作系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
